{
  "name": "hirques/opsdesk-api",
  "type": "project",
  "description": "Role-based operations ticketing REST API built with Laravel, Sanctum and PostgreSQL.",
  "keywords": ["laravel", "api", "docker", "postgresql", "sanctum", "rbac", "swagger"],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "laravel/sanctum": "^4.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}
  },
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "test": ["@php vendor/bin/phpunit"]
  },
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable",
  "prefer-stable": true
}
